APP_NAME=gopher-identity-service
APP_ENV=development
APP_HTTP_PORT=8080
APP_GRPC_PORT=9090
APP_SECRET_KEY=your-secret-key-here
APP_MAX_DEVICES_PER_USSER=3

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=foody_identity

LOGGER_LEVEL=debug

JWT_ACCESS_SECRET=jwt_access_token_secret
JWT_ACCESS_TTL=30m

JWT_REFRESH_SECRET=jwt_refresh_token_secret
JWT_REFRESH_TTL=7d